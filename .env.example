# Copie ce fichier vers .env.local puis remplis les valeurs.
# .env.local est ignoré par git : les secrets n'arrivent jamais sur GitHub.

# --- Application Discord (Developer Portal > OAuth2 > Client ID) ---
# Utilisé uniquement pour l'invitation du bot (lib/bot.ts).
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# --- Bot Discord (Developer Portal > Bot > Token) ---
# ⚠️ Ce token ne doit être lu QUE par scripts/bot-api.mjs (côté serveur).
# Ne JAMAIS le préfixer par NEXT_PUBLIC_ : il serait visible par tous.
DISCORD_BOT_TOKEN=
DISCORD_BOT_ID=
BOT_API_PORT=8787

# Adresse que le navigateur utilise pour interroger l'API du bot.
# En local : http://localhost:8787
NEXT_PUBLIC_BOT_API_URL=http://localhost:8787
